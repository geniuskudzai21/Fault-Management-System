# Neon Postgres connection string.
# Use the "-pooler" host for long-running servers (Render).
# Dashboard: Neon console -> Connection Details -> Pooled connection
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Secret used to sign JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me

# Comma-separated list of allowed browser origins. Leave empty to allow all.
CORS_ORIGINS=http://localhost:3000

# Ignored on Render (it sets PORT itself)
PORT=3002